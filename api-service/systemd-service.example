# Example systemd service file
# Copy to: /etc/systemd/system/memory-api.service
# Then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable memory-api
#   sudo systemctl start memory-api

[Unit]
Description=Memory API Service
After=network.target

[Service]
Type=simple
User=arkanfadhilkautsar
WorkingDirectory=/Users/arkanfadhilkautsar/Downloads/remembar/api-service
Environment="PATH=/Users/arkanfadhilkautsar/Downloads/remembar/api-service/venv/bin"
ExecStart=/Users/arkanfadhilkautsar/Downloads/remembar/api-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

