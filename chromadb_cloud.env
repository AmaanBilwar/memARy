# ChromaDB Cloud Configuration for Memary
# Copy this to .env and add your API key

USE_CHROMA_CLOUD=true
CHROMA_TENANT=arkankau
CHROMA_DATABASE=remembar
CHROMA_API_KEY=YOUR_CHROMADB_CLOUD_API_KEY_HERE

# Vector Store
VECTOR_STORE_URL=http://localhost:8001

# Other settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===========================================
# GET YOUR API KEY:
# 1. Go to: https://www.trychroma.com/
# 2. Login to your account
# 3. Navigate to Settings or API Keys
# 4. Copy your API key
# 5. Replace YOUR_CHROMADB_CLOUD_API_KEY_HERE above
# ===========================================

